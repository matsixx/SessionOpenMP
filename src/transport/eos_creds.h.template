// SessionOpenMP -- TEMPLATE for the EOS product credentials.
//
// COPY THIS FILE TO `eos_creds.h` (same folder) AND FILL IN YOUR OWN VALUES. The real file is
// gitignored, so it never lands in the repo; this template is what is tracked.
//
// Where the values come from: the Epic Games Dev Portal -> your Product -> Product Settings gives
// Product/Sandbox/Deployment ids, and the Clients section gives the client id + secret.
//
// THE CLIENT SECRET IS NOT A CONFIDENTIALITY BOUNDARY. It ships inside main.dll and anyone can
// pull it out of the binary -- that is true of every EOS-integrated game, and the SDK's design
// assumes it. What actually limits the damage is the CLIENT POLICY attached to the client in the
// Dev Portal: keep it to the narrowest one that still works (Connect + Lobbies + P2P), and do NOT
// grant Player Data Storage, Title Storage, Ecom or anything else the mod does not use. Abuse via
// your deployment is attributed to your Epic account, so the policy is the control that matters.
//
// One deployment = one lobby namespace. Players running builds with DIFFERENT credentials cannot
// see each other's lobbies at all, so "everyone brings their own key" is not a workable model for a
// mod people are meant to play together -- ship one set of credentials with the build.
#pragma once
static const char* OMP_PRODUCT_ID    = "PUT_YOUR_PRODUCT_ID_HERE";
static const char* OMP_SANDBOX_ID    = "PUT_YOUR_SANDBOX_ID_HERE";
static const char* OMP_DEPLOYMENT_ID = "PUT_YOUR_DEPLOYMENT_ID_HERE";
static const char* OMP_CLIENT_ID     = "PUT_YOUR_CLIENT_ID_HERE";
static const char* OMP_CLIENT_SECRET = "PUT_YOUR_CLIENT_SECRET_HERE";
